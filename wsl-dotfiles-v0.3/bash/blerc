# ==============================================================================
# ~/.blerc — ble.sh (Bash Line Editor) settings
#   ble.sh gives bash what zsh-autosuggestions + zsh-syntax-highlighting +
#   a completion menu give zsh.  Manual: https://github.com/akinomyoga/ble.sh
#   Update ble.sh itself with:  ble-update
# ==============================================================================

# --- autosuggestions & completion menu --------------------------------------------
bleopt complete_auto_delay=50              # ms until the grey suggestion appears
bleopt complete_menu_style=align-nowrap
bleopt filename_ls_colors="$LS_COLORS"     # colour paths like ls/eza do

# starship already shows failed commands (red ❯) — hide ble's "[ble: exit N]" line
bleopt exec_errexit_mark=

# dimmer suggestion text that reads well on dark themes
ble-face auto_complete='fg=242'

# --- key bindings (emacs mode, the bash default) -----------------------------------
function my/blerc/emacs-bindings {
  # zsh-style: Up/Down search history by what is already typed
  ble-bind -m emacs -f up   'history-search-backward immediate-accept'
  ble-bind -m emacs -f down 'history-search-forward immediate-accept'

  # your git pickers (functions in ~/.bashrc.d/60-bindkeys.bash)
  ble-bind -m emacs -x 'C-g f' _w_git_file
  ble-bind -m emacs -x 'C-g b' _w_git_branch
  ble-bind -m emacs -x 'C-g l' _w_git_commit
}
blehook/eval-after-load keymap_emacs my/blerc/emacs-bindings

# Accept the suggestion with Tab as well (default: → / End / C-f).
# ble-bind -m auto_complete -f TAB auto_complete/insert

