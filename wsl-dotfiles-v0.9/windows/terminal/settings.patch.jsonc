// =====================================================================================
// Windows Terminal — settings merged into your settings.json by apply-terminal.ps1
//   * global keys below overwrite yours, everything else in your file is kept
//   * actions/keybindings use ids "User.dotfiles.*" → re-running replaces them cleanly
//   * the profiles (Ubuntu · bash / zsh / tmux) and the Tokyo Night scheme come from the
//     fragment that the WSL install.sh writes
// Docs: https://learn.microsoft.com/windows/terminal/customize-settings/startup
// =====================================================================================
{
  // ---------------- session restore ------------------------------------------------
  // Reopen every window, tab and pane (with its working directory and, since 1.21, the
  // screen contents) from the previous session — also after a reboot.
  //   alt: "defaultProfile" → always start with one fresh tab
  "firstWindowPreference": "persistedWindowLayout",

  // Start Windows Terminal at login → together with the line above, a reboot brings
  // your terminal layout back without touching anything.
  //   alt: false → start it yourself
  "startOnUserLogin": true,

  // `wt` / new terminal invocations open as a tab in the existing window.
  //   alt: "useNew" → always a new window, "useAnyExisting" → any window, even other desktops
  "windowingBehavior": "useExisting",

  // Ask before closing a window with several tabs (protects the layout you want restored).
  "confirmCloseAllTabs": true,

  // ---------------- behaviour ------------------------------------------------------
  "copyOnSelect": true,            // select = copy (like tmux/X11). alt: false → Ctrl+C to copy
  "copyFormatting": "none",        // plain text only. alt: "all" → keep colours/HTML
  "trimBlockSelection": true,
  "focusFollowMouse": true,        // pane under the mouse gets focus. alt: false
  "snapToGridOnResize": true,
  "alwaysShowTabs": true,
  "showTabsInTitlebar": true,
  "tabSwitcherMode": "mru",        // Ctrl+Tab = most recently used. alt: "inOrder", "disabled"
  "useAcrylicInTabRow": false,

  // ---------------- defaults for every profile -------------------------------------
  "profiles": {
    "defaults": {
      "font": { "face": "JetBrainsMono Nerd Font", "size": 11 },
      "colorScheme": "Tokyo Night",
      "padding": "6",
      "historySize": 50000,
      "bellStyle": "none",
      "cursorShape": "filledBox",
      "intenseTextStyle": "bright",
      "closeOnExit": "graceful",
      "opacity": 97,
      "useAcrylic": false,
      "scrollbarState": "hidden"
    }
  },

  // ---------------- actions (what) ---------------------------------------------------
  "actions": [
    // give these keys to tmux / the shells instead of Windows Terminal
    { "command": "unbound", "keys": "alt+space" },        // tmux which-key menu
    { "command": "unbound", "keys": "ctrl+shift+space" },

    // splits — "duplicate" opens the same profile in the same directory
    { "id": "User.dotfiles.splitRight", "command": { "action": "splitPane", "split": "right", "splitMode": "duplicate" } },
    { "id": "User.dotfiles.splitDown",  "command": { "action": "splitPane", "split": "down",  "splitMode": "duplicate" } },
    { "id": "User.dotfiles.splitAuto",  "command": { "action": "splitPane", "split": "auto",  "splitMode": "duplicate" } },
    { "id": "User.dotfiles.zoomPane",   "command": "togglePaneZoom" },
    { "id": "User.dotfiles.closePane",  "command": "closePane" },
    { "id": "User.dotfiles.swapLeft",   "command": { "action": "swapPane", "direction": "left" } },
    { "id": "User.dotfiles.swapRight",  "command": { "action": "swapPane", "direction": "right" } },
    { "id": "User.dotfiles.broadcast",  "command": "toggleBroadcastInput" },   // type into all panes of a tab
    { "id": "User.dotfiles.renameTab",  "command": "openTabRenamer" },
    { "id": "User.dotfiles.tabColor",   "command": "openTabColorPicker" },
    { "id": "User.dotfiles.tmuxTab",    "command": { "action": "newTab", "profile": "{6a3e2f41-8c1d-4b7e-9f20-3d5a1c7e0b13}" } },

    // ready-made layouts
    // Dev: editor/shell 60 % left │ two shells stacked right
    {
      "id": "User.dotfiles.layoutDev",
      "name": "Layout: Dev (60 | 40 stacked)",
      "command": {
        "action": "multipleActions",
        "actions": [
          { "action": "newTab", "profile": "{6a3e2f41-8c1d-4b7e-9f20-3d5a1c7e0b12}", "tabTitle": "dev" },
          { "action": "splitPane", "split": "right", "size": 0.4, "profile": "{6a3e2f41-8c1d-4b7e-9f20-3d5a1c7e0b12}" },
          { "action": "splitPane", "split": "down", "size": 0.5, "profile": "{6a3e2f41-8c1d-4b7e-9f20-3d5a1c7e0b12}" },
          { "action": "moveFocus", "direction": "left" }
        ]
      }
    },
    // Ops: 2 × 2 grid (e.g. k9s │ logs / shell │ btop) — combine with broadcast input
    {
      "id": "User.dotfiles.layoutOps",
      "name": "Layout: Ops (2 × 2)",
      "command": {
        "action": "multipleActions",
        "actions": [
          { "action": "newTab", "profile": "{6a3e2f41-8c1d-4b7e-9f20-3d5a1c7e0b12}", "tabTitle": "ops" },
          { "action": "splitPane", "split": "right", "size": 0.5, "profile": "{6a3e2f41-8c1d-4b7e-9f20-3d5a1c7e0b12}" },
          { "action": "splitPane", "split": "down",  "size": 0.5, "profile": "{6a3e2f41-8c1d-4b7e-9f20-3d5a1c7e0b12}" },
          { "action": "moveFocus", "direction": "left" },
          { "action": "splitPane", "split": "down",  "size": 0.5, "profile": "{6a3e2f41-8c1d-4b7e-9f20-3d5a1c7e0b12}" },
          { "action": "moveFocus", "direction": "up" }
        ]
      }
    }
  ],

  // ---------------- key bindings (how) — chosen to work on a German (QWERTZ) keyboard
  //  default WT keys that stay: Alt+←↑→↓ focus pane · Alt+Shift+←↑→↓ resize pane
  //  Ctrl+Shift+P command palette · Ctrl+Shift+F find · Ctrl+Shift+W close pane
  //  Ctrl+Alt+1…9 go to tab · Win+^ quake window (global summon)
  "keybindings": [
    { "id": "User.dotfiles.splitRight", "keys": "alt+shift+v" },
    { "id": "User.dotfiles.splitDown",  "keys": "alt+shift+h" },
    { "id": "User.dotfiles.splitAuto",  "keys": "alt+shift+d" },
    { "id": "User.dotfiles.zoomPane",   "keys": "alt+shift+z" },
    { "id": "User.dotfiles.closePane",  "keys": "alt+shift+x" },
    { "id": "User.dotfiles.swapLeft",   "keys": "alt+shift+pgup" },
    { "id": "User.dotfiles.swapRight",  "keys": "alt+shift+pgdn" },
    { "id": "User.dotfiles.broadcast",  "keys": "alt+shift+b" },
    { "id": "User.dotfiles.renameTab",  "keys": "alt+shift+r" },
    { "id": "User.dotfiles.tabColor",   "keys": "alt+shift+c" },
    { "id": "User.dotfiles.tmuxTab",    "keys": "alt+shift+t" },
    { "id": "User.dotfiles.layoutDev",  "keys": "alt+shift+1" },
    { "id": "User.dotfiles.layoutOps",  "keys": "alt+shift+2" }
  ]
}
