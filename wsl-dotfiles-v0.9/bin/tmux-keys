#!/usr/bin/env bash
# ==============================================================================
# tmux-keys — which-key style, fuzzy-searchable list of ALL tmux key bindings
#   Opened by  prefix ?  (popup). Shows the note (description) for each key;
#   keys without a note show their command instead. Type to filter, Esc to close.
# ==============================================================================
export PATH="$HOME/.local/bin:$HOME/.fzf/bin:$PATH"

prefix="$(tmux show -gv prefix 2>/dev/null || echo C-b)"

section() {  # <title> <list-keys args…>
  local title=$1
  shift
  tmux list-keys -N -a "$@" 2>/dev/null | sed "s/^/$(printf '\033[35m')[$title]$(printf '\033[0m') /"
}

list() {
  section "prefix" -T prefix -P "$prefix "
  section "root  " -T root -P ""
  section "copy  " -T copy-mode-vi -P ""
}

if command -v fzf >/dev/null 2>&1; then
  list | fzf --ansi --no-sort --layout=reverse --border=none --info=inline \
    --prompt='keys> ' \
    --header="prefix = $prefix   ·   [prefix] press prefix first · [root] direct · [copy] in copy mode   ·   Esc closes"
else
  list | less -R
fi
