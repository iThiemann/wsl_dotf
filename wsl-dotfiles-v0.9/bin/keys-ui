#!/usr/bin/env bash
# ==============================================================================
# keys-ui — renders the `keys` overview (see ~/.config/shell/keys.sh)
#
#   keys-ui [--dump DIR] [--select] [-p|--print] [--refresh] [--export [DIR]] [SECTION…]
#
#   Sections are built from:
#     · the live shell dump (aliases, functions, key bindings)  → bash/zsh, aliases: *, functions: *
#     · ~/.config/shell/keys/NN-*.tsv  static sheets            → atuin, fzf, k9s, lazygit, windows…
#     · tmux (live server, else parsed from tmux.conf)          → tmux
#     · nvim (headless keymap dump, cached)                     → nvim
#     · git config aliases                                      → git config
#     · windows/autohotkey/devops.ahk                           → autohotkey
# ==============================================================================
set -uo pipefail
export LC_ALL="${LC_ALL:-C.UTF-8}"

DUMP="" SELECT=0 PRINT=0 REFRESH=0 EXPORT="" SECTIONS=()
while (($#)); do
  case "$1" in
    --dump) DUMP="$2"; shift ;;
    --select) SELECT=1 ;;
    -p | --print) PRINT=1 ;;
    --refresh) REFRESH=1 ;;
    --export)
      if [[ ${2-} && ${2:0:1} != - ]]; then EXPORT="$2"; shift; else EXPORT="auto"; fi ;;
    -h | --help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) SECTIONS+=("$1") ;;
  esac
  shift
done

KEYS_DIR="$HOME/.config/shell/keys"
REPO="$(cd "$(readlink -f "$HOME/.config/shell")/.." 2>/dev/null && pwd)"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/keys"
mkdir -p "$CACHE"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
ALL="$WORK/all.tsv"            # section \t key \t description \t insert-text
: >"$ALL"

AWK="$(command -v gawk || command -v awk)"
emit() { [[ -n ${2// /} ]] && printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4-}" >>"$ALL"; }

SHELL_NAME="$(cat "$DUMP/shell" 2>/dev/null || basename "${SHELL:-bash}")"

# ------------------------------------------------------------------ key notation ------
# converts zsh bindkey / readline notation to readable keys: "^X^E" → "Ctrl-x Ctrl-e"
KEYCONV='
function keyname(k,    out, alt, i, c, n, sp, matched, tok) {
  # readline → caret notation
  gsub(/\\C-\?/, "^?", k); gsub(/\\e/, "^[", k); gsub(/\\M-/, "^[", k)
  while (match(k, /\\C-./)) { c = substr(k, RSTART + 3, 1); k = substr(k, 1, RSTART - 1) "^" toupper(c) substr(k, RSTART + 4) }
  gsub(/\\\\/, "\\", k); gsub(/\\"/, "\"", k)
  n = split("^[[1;5A ^[[1;5B ^[[1;5C ^[[1;5D ^[[1;3A ^[[1;3B ^[[1;3C ^[[1;3D ^[[1;2A ^[[1;2B ^[[3;5~ ^[[200~ ^[[3~ ^[[2~ ^[[5~ ^[[6~ ^[[H ^[[F ^[OH ^[OF ^[[A ^[[B ^[[C ^[[D ^[OA ^[OB ^[OC ^[OD ^[OP ^[OQ ^[OR ^[OS ^[[11~ ^[[Z ^[^? ^[^H", sp, " ")
  split("Ctrl-↑ Ctrl-↓ Ctrl-→ Ctrl-← Alt-↑ Alt-↓ Alt-→ Alt-← Shift-↑ Shift-↓ Ctrl-Del paste Del Ins PgUp PgDn Home End Home End ↑ ↓ → ← ↑ ↓ → ← F1 F2 F3 F4 F1 Shift-Tab Alt-Backspace Alt-Backspace", nm, " ")
  out = ""; alt = 0; i = 1
  while (i <= length(k)) {
    matched = 0
    for (j = 1; j <= n; j++) {
      if (substr(k, i, length(sp[j])) == sp[j]) { tok = nm[j]; i += length(sp[j]); matched = 1; break }
    }
    if (!matched) {
      if (substr(k, i, 2) == "^[") { alt = 1; i += 2; continue }
      c = substr(k, i, 1)
      if (c == "^" && i < length(k)) {
        c = substr(k, i + 1, 1); i += 2
        if (c == "?") tok = "Backspace"
        else if (c == "I") tok = "Tab"
        else if (c == "M") tok = "Enter"
        else if (c == "@" || c == " ") tok = "Ctrl-Space"
        else if (c == "[") tok = "Esc"
        else tok = "Ctrl-" tolower(c)
      } else if (c == " ") { tok = "Space"; i++ }
      else { tok = c; i++ }
    }
    if (alt) { tok = "Alt-" tok; alt = 0 }
    out = out (out == "" ? "" : " ") tok
  }
  if (alt) out = out (out == "" ? "" : " ") "Esc"
  return out
}'

# widget / readline function descriptions
cat >"$WORK/widgets.tsv" <<'EOF'
beginning-of-line	cursor to start of line
end-of-line	cursor to end of line
forward-char	cursor right
backward-char	cursor left
forward-word	cursor one word forward
backward-word	cursor one word back
emacs-forward-word	cursor one word forward
emacs-backward-word	cursor one word back
kill-line	delete to end of line
backward-kill-line	delete to start of line
unix-line-discard	delete to start of line
kill-whole-line	delete whole line
kill-word	delete word after cursor
backward-kill-word	delete word before cursor
unix-word-rubout	delete word before cursor
yank	paste last deleted text
yank-pop	cycle older deleted text
transpose-chars	swap two characters
transpose-words	swap two words
capitalize-word	Capitalize word
up-case-word	UPPERCASE word
down-case-word	lowercase word
undo	undo
redo	redo
clear-screen	clear screen
accept-line	run command
accept-and-hold	run command, keep it on the prompt
accept-line-and-down-history	run command, show next history line
history-search-backward	history search by typed prefix (back)
history-search-forward	history search by typed prefix (forward)
up-line-or-history	previous line / history entry
down-line-or-history	next line / history entry
up-line-or-beginning-search	history search by typed prefix (back)
down-line-or-beginning-search	history search by typed prefix (forward)
previous-history	previous history entry
next-history	next history entry
beginning-of-history	first history entry
end-of-history	last history entry
history-incremental-search-backward	incremental history search (back)
history-incremental-search-forward	incremental history search (forward)
reverse-search-history	incremental history search (back)
forward-search-history	incremental history search (forward)
expand-or-complete	complete
complete	complete
complete-word	complete word
menu-complete	cycle completions
reverse-menu-complete	cycle completions backwards
list-choices	list completions
possible-completions	list completions
delete-char-or-list	delete char / list completions
delete-char	delete character
backward-delete-char	delete character before cursor
push-line	park line, run another, get it back
push-line-or-edit	park line (or multi-line edit)
edit-command-line	edit command line in $EDITOR
edit-and-execute-command	edit command line in $EDITOR
quoted-insert	insert next key literally
send-break	abort current edit
run-help	help for the command (man)
which-command	which/type for the command
insert-last-word	insert last argument of previous command
yank-last-arg	insert last argument of previous command
copy-prev-shell-word	duplicate previous word
quote-line	quote the whole line
exchange-point-and-mark	swap cursor and mark
set-mark-command	set mark
overwrite-mode	toggle overwrite mode
vi-cmd-mode	switch to vi normal mode
expand-history	expand !history
expand-word	expand word (globs, vars)
list-expand	show expansion
describe-key-briefly	describe a key
where-is	where is a widget bound
execute-named-cmd	run a widget by name
get-line	pop parked line
pound-insert	comment out line
insert-comment	comment out line
spell-word	spelling correction
glob-complete-word	complete glob
dynamic-complete-history	complete from history
bracketed-paste	paste (bracketed)
autosuggest-accept	accept autosuggestion
autosuggest-execute	accept + run autosuggestion
autosuggest-clear	clear autosuggestion
atuin-search	atuin history search
atuin-up-search	atuin search (up arrow)
fzf-file-widget	fzf: insert file path(s)
fzf-cd-widget	fzf: cd into directory
fzf-history-widget	fzf: history search
fzf-completion	fzf completion (**<Tab>)
fzf-g-file-widget	pick tracked git file → insert path (gcof)
fzf-g-branch-widget	pick git branch → switch (gcob)
fzf-g-commit-widget	pick commit → insert hash (glog)
keys-widget	this overview (keys)
sudo-command-line	prefix line with sudo
"_w_git_file"	pick tracked git file → insert path (gcof)
"_w_git_branch"	pick git branch → switch (gcob)
"_w_git_commit"	pick commit → insert hash (glog)
"__keys_widget"	this overview (keys)
EOF

# ---------------------------------------------------------------- static sheets ------
for f in "$KEYS_DIR"/[0-9]*.tsv; do
  [[ -r $f ]] || continue
  base="$(basename "$f")"
  [[ $base == 10-bash.tsv && $SHELL_NAME != bash ]] && continue
  [[ $base == 11-zsh-extra.tsv && $SHELL_NAME != zsh ]] && continue
  sect="$(head -n1 "$f" | sed -E 's/^# *([^:]+):.*/\1/')"
  tail -n +2 "$f" | while IFS=$'\t' read -r k d; do
    [[ -z $k || $k == \#* ]] && continue
    emit "$sect" "$k" "$d"
  done
done

# ------------------------------------------------------------- live key bindings ------
if [[ $SHELL_NAME == zsh && -s $DUMP/bindkeys ]]; then
  "$AWK" -v sect="zsh" "$KEYCONV"'
    FNR == NR { split($0, a, "\t"); desc[a[1]] = a[2]; next }
    {
      if ($0 ~ /"-"/) next                                  # ranges like "!"-"~"
      w = $NF; if (w ~ /^(self-insert|self-insert-unmeta|undefined-key|digit-argument|universal-argument|neg-argument)$/) next
      k = $0; sub(/^"/, "", k); sub(/" [^ ]+$/, "", k)
      if (k ~ /^[ -~]$/) next                               # printable keys type themselves
      d = (w in desc) ? desc[w] : w
      kn = keyname(k); if (kn ~ /^ *$/) next
      printf "%s\t%s\t%s\t\n", sect, kn, d
    }' "$WORK/widgets.tsv" "$DUMP/bindkeys" >>"$ALL"
elif [[ $SHELL_NAME == bash && -s $DUMP/bind ]]; then
  "$AWK" -v sect="bash (readline, all)" "$KEYCONV"'
    FNR == NR { split($0, a, "\t"); desc[a[1]] = a[2]; next }
    {
      w = $NF; if (w ~ /^(self-insert|digit-argument|universal-argument|do-lowercase-version|prefix-meta)$/) next
      k = $0; sub(/^"/, "", k); sub(/": .*$/, "", k)
      if (k ~ /^[ -~]$/) next
      d = (w in desc) ? desc[w] : w
      kn = keyname(k); if (kn ~ /^ *$/) next
      printf "%s\t%s\t%s\t\n", sect, kn, d
    }' "$WORK/widgets.tsv" "$DUMP/bind" >>"$ALL"
  [[ -s $DUMP/bindx ]] && "$AWK" -v sect="bash (readline, all)" "$KEYCONV"'
    FNR == NR { split($0, a, "\t"); desc[a[1]] = a[2]; next }
    { k = $1; sub(/^"/, "", k); sub(/":$/, "", k); w = $2
      printf "%s\t%s\t%s\t\n", sect, keyname(k), ((w in desc) ? desc[w] : "runs " w) }' \
    "$WORK/widgets.tsv" "$DUMP/bindx" >>"$ALL"
fi

# ---------------------------------------------------------- aliases + functions ------
DESC="$KEYS_DIR/descriptions.tsv"
if [[ -s ${DUMP}/aliases ]]; then
  "$AWK" -F'\t' '
    FNR == NR { if ($0 !~ /^#/ && NF >= 3) { cat[$1] = $2; desc[$1] = $3 }; next }
    {
      line = $0
      sub(/^alias /, "", line); sub(/^-- /, "", line)
      eq = index(line, "="); if (!eq) next
      name = substr(line, 1, eq - 1); val = substr(line, eq + 1)
      if (val ~ /^\x27.*\x27$/) val = substr(val, 2, length(val) - 2)
      gsub(/\x27\\\x27\x27/, "\x27", val)
      split(val, w, " "); first = w[1]; if (first == "sudo" || first == "command" || first == "noglob") first = w[2]
      c = "general"
      if (first ~ /^(git|gitk|lazygit|tig)$/) c = "git"
      else if (first ~ /^(kubectl|k|kubens|kubectx|oc|k9s|kustomize|minikube|kind)$/) c = "kubernetes"
      else if (first ~ /^(helm|helmfile)$/) c = "helm"
      else if (first ~ /^(terraform|tofu|terragrunt|tf|packer)$/) c = "terraform / tofu"
      else if (first ~ /^ansible/) c = "ansible"
      else if (first ~ /^(docker|podman|docker-compose|nerdctl)$/) c = "containers"
      else if (first ~ /^(aws|gcloud|az)$/) c = "cloud"
      else if (first ~ /^(tmux)$/) c = "tmux"
      else if (first ~ /^(eza|ls|lt|tree)$/) c = "files"
      else if (first ~ /^(cd|z|pushd|popd|u)$/) c = "navigation"
      else if (first ~ /^(nvim|vim|vi|code|NVIM_APPNAME=nvim)$/) c = "editor"
      else if (first ~ /^(apt|dpkg|snap|systemctl|journalctl)$/) c = "system"
      else if (first ~ /^(python|python3|pip|pip3|uv|poetry|pyenv)$/) c = "python"
      else if (first ~ /^(npm|yarn|pnpm|node|npx)$/) c = "node"
      else if (first ~ /^(go)$/) c = "go"
      else if (first ~ /^(cargo|rustc|rustup)$/) c = "rust"
      else if (first ~ /^(grep|rg|fd|find|fzf)$/) c = "search"
      if (name in cat) c = cat[name]
      d = (name in desc) ? desc[name] " (→ " val ")" : "→ " val
      printf "aliases: %s\t%s\t%s\t%s\n", c, name, d, name
    }' "$DESC" "$DUMP/aliases" >>"$ALL"
fi

if [[ -s ${DUMP}/functions ]]; then
  "$AWK" -F'\t' '
    FNR == NR { if ($0 !~ /^#/ && NF >= 3) { cat[$1] = $2; desc[$1] = $3 }; next }
    {
      f = $0
      if (f in desc) { printf "functions: %s\t%s\t%s\t%s\n", cat[f], f, desc[f], f; next }
      if (f ~ /^[_+.]/ || f ~ /::/ || f ~ /^(omz|prompt|zle|compdef|compinit|bashcompinit|is-at-least|add-zsh-hook|zsh_|starship_|__|command_not_found|is_plugin|is_theme|env_default|default|spectrum|chpwd|precmd|preexec|ble|path_prepend|blehook|ble-|async|zrecompile|colors|zmv|zcalc|zargs|run-help|title|open_command|git_prompt|parse_git|_)/) next
      printf "functions: other\t%s\t%s\t%s\n", f, "(shell function — type " f " to see it)", f
    }' "$DESC" "$DUMP/functions" >>"$ALL"
fi

# ------------------------------------------------------------------ git config -------
if command -v git >/dev/null 2>&1; then
  git config --get-regexp '^alias\.' 2>/dev/null | while read -r k v; do
    k="${k#alias.}"
    emit "git config" "git $k" "$v" "git $k"
  done
fi

# ------------------------------------------------------------------------ tmux -------
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  { tmux list-keys -N -T prefix -P "" | sed 's/^/prefix /'
    tmux list-keys -N -T root -P "" | sed 's/^/(no prefix) /'
    tmux list-keys -N -a -T copy-mode-vi -P "" | sed 's/^/copy-mode /'; } 2>/dev/null |
    while read -r tbl key rest; do
      [[ $tbl == "(no" ]] && { tbl="(no prefix)"; read -r key rest <<<"$rest"; }
      case $tbl in prefix) label="prefix $key" ;; copy-mode) label="copy-mode $key" ;; *) label="$key" ;; esac
      emit "tmux" "$label" "$rest"
    done
elif [[ -r $HOME/.config/tmux/tmux.conf ]]; then
  sed -nE 's/^bind(-key)? (.*)-N "([^"]*)" +([^ ]+).*/F:\2\t\3\t\4/p' "$HOME/.config/tmux/tmux.conf" |
    while IFS=$'\t' read -r flags note key; do
      if [[ $key == \'*\' && ${#key} -gt 2 ]]; then key="${key:1:-1}"; fi
      if [[ $flags == *"-n"* ]]; then label="$key"
      elif [[ $flags == *copy-mode-vi* ]]; then label="copy-mode $key"
      else label="prefix $key"; fi
      emit "tmux" "$label" "$note"
    done
  while IFS=$'\t' read -r k d; do emit "tmux" "$k" "$d"; done <<'EOF'
prefix o	session manager (tmux-sessionx)
prefix C-s / C-r	save / restore sessions (tmux-resurrect; auto every 10 min)
prefix I / U / M-u	TPM: install / update / clean plugins
prefix u	open a URL from the pane (tmux-fzf-url)
prefix F	tmux-fzf: manage sessions, windows, panes, commands
C-h / C-j / C-k / C-l	move between nvim splits and tmux panes (vim-tmux-navigator)
copy-mode o / C-o	open selection / open in $EDITOR (tmux-open)
EOF
fi

# ------------------------------------------------------------------------ nvim -------
NVIM_CACHE="$CACHE/nvim.tsv"
if command -v nvim >/dev/null 2>&1 && [[ -d $HOME/.config/nvim/lua/devops ]]; then
  stale=0
  [[ ! -s $NVIM_CACHE || $REFRESH == 1 ]] && stale=1
  [[ $stale == 0 && -n $(find -L "$HOME/.config/nvim/lua" -newer "$NVIM_CACHE" -name '*.lua' 2>/dev/null | head -n1) ]] && stale=1
  if [[ $stale == 1 ]]; then
    [[ $PRINT == 0 && -t 2 ]] && printf 'reading nvim key maps…\r' >&2
    timeout 40 nvim --headless -c "lua require('devops.keys').dump('$NVIM_CACHE')" -c 'qa!' >/dev/null 2>&1 || true
  fi
  [[ -s $NVIM_CACHE ]] && while IFS=$'\t' read -r k d; do emit "nvim" "$k" "$d"; done <"$NVIM_CACHE"
fi

# ------------------------------------------------------------------ autohotkey -------
AHK="$REPO/windows/autohotkey/devops.ahk"
if [[ -r $AHK ]]; then
  sed -nE \
    -e 's/^(Caps|Hyper)\("([^"]+)", *"([^"]+)".*/Hyper-\2\t\3/p' \
    -e 's/^Help\("([^"]+)", *"([^"]+)"\).*/\1\t\2/p' \
    -e 's/^HS\("([^"]+)", *"([^"]+)".*/\1 (type it)\t\2/p' "$AHK" |
    while IFS=$'\t' read -r k d; do emit "autohotkey" "$k" "$d"; done
fi

# ================================================================== output ===========
ORDER="$SHELL_NAME|aliases: git|aliases: kubernetes|aliases: helm|aliases: terraform / tofu|aliases: containers|aliases: ansible|aliases: cloud|aliases: navigation|aliases: files|aliases: general|aliases:|functions:|git config|atuin|fzf|tmux|nvim|k9s|lazygit|windows-terminal|autohotkey|windows"

sections() {
  "$AWK" -F'\t' -v order="$ORDER" '
    { n[$1]++ }
    END {
      k = split(order, o, "|")
      for (s in n) { r = 999; for (i = 1; i <= k; i++) if (index(s, o[i]) == 1) { r = i; break }; printf "%03d\t%s\t%d\n", r, s, n[s] }
    }' "$ALL" | sort -t$'\t' -k1,1n -k2,2 | cut -f2,3
}

rows_for() {   # $1 = section name, "*" = everything, or a substring when SUBSTR=1
  "$AWK" -F'\t' -v s="$1" -v sub_="${SUBSTR:-0}" '
    s == "*" || $1 == s || (sub_ == 1 && (index(tolower($1), tolower(s)) || index(tolower($2), tolower(s)))) {
      printf "%s\t%-30s\t%s\t%s\n", $1, $2, $3, $4 }' "$ALL"
}

# --export: one TSV per section for the Windows viewer (AutoHotkey Caps+F2)
if [[ -n $EXPORT ]]; then
  if [[ $EXPORT == auto ]]; then
    winhome="$(cd /mnt/c 2>/dev/null && cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')"
    [[ -n $winhome ]] || { echo "not on WSL — give a directory: keys --export DIR" >&2; exit 1; }
    EXPORT="$(wslpath -u "$winhome")/.keys"
  fi
  mkdir -p "$EXPORT"
  rm -f "$EXPORT"/*.tsv
  sections | while IFS=$'\t' read -r s _; do
    fn="$(printf '%s' "$s" | tr -c 'A-Za-z0-9_.-' '_')"
    { echo "# $s"; "$AWK" -F'\t' -v s="$s" '$1 == s { print $2 "\t" $3 }' "$ALL"; } >"$EXPORT/$fn.tsv"
  done
  echo "exported $(ls "$EXPORT" | wc -l) sheets → $EXPORT"
  exit 0
fi

# -p: plain output
if [[ $PRINT == 1 ]]; then
  if ((${#SECTIONS[@]} == 0)); then
    sections | while IFS=$'\t' read -r s _; do rows_for "$s"; done
  else for s in "${SECTIONS[@]}"; do SUBSTR=1 rows_for "$s"; done; fi |
    "$AWK" -F'\t' '$1 != last { printf "\n== %s ==\n", $1; last = $1 } { printf "  %s  %s\n", $2, $3 }'
  exit 0
fi

command -v fzf >/dev/null 2>&1 || { echo "fzf missing — use keys -p" >&2; exit 1; }

FZF_COMMON=(--ansi --layout=reverse --height=90% --border=rounded --info=inline --cycle)

pick_rows() {   # stdin: rows; prints insert text (select mode) and returns 0 on Enter
  local title=$1 sel
  sel="$(fzf "${FZF_COMMON[@]}" --delimiter=$'\t' --with-nth=2,3 --tiebreak=index \
    --prompt="$title ❯ " --header='Enter: choose (aliases/functions are inserted)  ·  Esc: back' )" || return 1
  local ins; ins="$(cut -f4 <<<"$sel")"
  if [[ $SELECT == 1 ]]; then printf '%s' "$ins"; else printf '%s\n' "$(cut -f2- <<<"$sel" | tr -s ' \t' ' ')"; fi
  return 0
}

# direct jump: keys git
if ((${#SECTIONS[@]} > 0)); then
  for s in "${SECTIONS[@]}"; do SUBSTR=1 rows_for "$s"; done | pick_rows "${SECTIONS[*]}"
  exit 0
fi

export KEYS_ALL="$ALL"
while :; do
  choice="$(sections | "$AWK" -F'\t' '{ printf "%s\t%s  (%d)\n", $1, $1, $2 }' |
    fzf "${FZF_COMMON[@]}" --delimiter=$'\t' --with-nth=2 --prompt='keys ❯ ' \
      --header=$'Enter: open  ·  Ctrl-a: search everything  ·  Esc: quit' \
      --preview='awk -F"\t" -v s={1} '"'"'$1 == s { printf "%-30s %s\n", $2, $3 }'"'"' "$KEYS_ALL"' \
      --preview-window=right,60%,border-left \
      --expect=ctrl-a)" || exit 0
  key="$(head -n1 <<<"$choice")"
  sect="$(sed -n 2p <<<"$choice" | cut -f1)"
  if [[ $key == ctrl-a ]]; then
    rows_for "*" | pick_rows "all" && exit 0
  elif [[ -n $sect ]]; then
    rows_for "$sect" | pick_rows "$sect" && exit 0
  fi
done
