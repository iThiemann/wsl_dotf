#!/usr/bin/env bash
# ==============================================================================
# git-credential-rbw — git credential helper backed by Bitwarden (rbw)
#
#   [credential "https://gitlab.company.com"]
#       helper =
#       helper = rbw            ← git runs this script as "git-credential-rbw get"
#       username = jdoe         (optional; picks the entry for that user)
#
# Looks up the vault entry by URL (rbw get accepts a name, UUID or URL). Store the
# personal access token as the entry's password and https://gitlab.company.com as its URI.
# Only "get" is implemented: the vault stays the source of truth, git never writes to it.
# ==============================================================================
set -uo pipefail
[[ ${1-} == get ]] || exit 0
command -v rbw >/dev/null 2>&1 || exit 0

declare -A in
while IFS='=' read -r k v; do
  [[ -z $k ]] && break
  in[$k]="$v"
done

host="${in[host]-}"
[[ -n $host ]] || exit 0
url="${in[protocol]:-https}://$host"

# entry for the given username, else the first entry matching the URL
if [[ -n ${in[username]-} ]]; then
  pass="$(rbw get "$url" "${in[username]}" 2>/dev/null)" || exit 0
  user="${in[username]}"
else
  full="$(rbw get --full "$url" 2>/dev/null)" || exit 0
  pass="$(head -n1 <<<"$full")"
  user="$(sed -n 's/^Username: //p' <<<"$full" | head -n1)"
fi
[[ -n $pass ]] || exit 0
[[ -n $user ]] && printf 'username=%s\n' "$user"
printf 'password=%s\n' "$pass"
