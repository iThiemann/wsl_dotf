# ~/.config/yamllint/config — used when a project has no .yamllint of its own
extends: relaxed
rules:
  line-length:
    max: 160
    level: warning
  truthy:
    allowed-values: ["true", "false", "yes", "no", "on", "off"]   # Ansible / GitHub Actions
  document-start: disable
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: consistent
    indent-sequences: whatever
