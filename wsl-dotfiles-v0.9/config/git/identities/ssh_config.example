# ~/.ssh/config — one Host alias per account when several keys hit the same server
Host gitlab-work
  HostName gitlab.company.com
  User git
  IdentityFile ~/.ssh/id_ed25519_work
  IdentitiesOnly yes

Host github-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_work
  IdentitiesOnly yes

# then:  git clone git@github-work:work-org/repo.git
# or rewrite automatically (in the work identity file):
#   [url "git@github-work:work-org/"]
#       insteadOf = git@github.com:work-org/
