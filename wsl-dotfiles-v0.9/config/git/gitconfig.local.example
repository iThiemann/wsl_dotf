# ==============================================================================
# ~/.gitconfig.local — EXAMPLE for several git servers, accounts and credentials
#   install.sh writes your default identity here; `git-identity add …` appends
#   blocks like the ones below. Everything here overrides ~/.gitconfig.
# ==============================================================================

# --- default identity (private) ---------------------------------------------------
[user]
	name = Max Mustermann
	email = max@example.org

# --- default credential helper for every https remote -------------------------------
# WSL + Git for Windows: share logins with Windows (GitHub/Azure DevOps OAuth, 2FA)
[credential]
	helper = /mnt/c/Program\\ Files/Git/mingw64/bin/git-credential-manager.exe

# --- WORK: all repos below ~/work/  OR  any repo whose remote is the company GitLab ----
[includeIf "gitdir:~/work/"]
	path = ~/.config/git/identities/work
[includeIf "hasconfig:remote.*.url:https://gitlab.company.com/**"]
	path = ~/.config/git/identities/work
[includeIf "hasconfig:remote.*.url:git@gitlab.company.com:*/**"]
	path = ~/.config/git/identities/work

# company GitLab over https: token from Bitwarden via rbw instead of GCM
[credential "https://gitlab.company.com"]
	helper =
	helper = rbw
	username = mmustermann

# --- CUSTOMER: own GitLab, own account, plain token cache -------------------------------
[includeIf "gitdir:~/customers/acme/"]
	path = ~/.config/git/identities/acme
[credential "https://git.acme.example"]
	helper =
	helper = cache --timeout=28800
	username = max.mustermann@acme.example

# --- two accounts on ONE host (github.com/private-org vs github.com/work-org) -------------
# useHttpPath makes git ask for credentials per repo path, not per host
[credential "https://github.com"]
	useHttpPath = true
[credential "https://github.com/work-org"]
	username = mmustermann-work
