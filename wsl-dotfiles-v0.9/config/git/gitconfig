# ==============================================================================
# ~/.gitconfig — managed by wsl-dotfiles
#
#   Personal data (name, e-mail, signing key, credential helper) lives in
#   ~/.gitconfig.local, included at the very end, so it overrides anything here
#   and never ends up in the dotfiles repo.
#
#   Check where a value comes from:   git config --show-origin --get <key>
#   List everything:                  git config --list --show-origin
#   Every option:                     git help config
# ==============================================================================

[core]
	# Editor for commit messages, interactive rebase, `git config -e`.
	#   alt: "code --wait"  → VS Code on Windows (blocks until the tab is closed)
	#   alt: "vim" / "nano"
	editor = nvim

	# Pager for log/diff/show. delta = syntax-highlighted, side-by-side-capable diffs.
	# The `|| less` fallback keeps git usable on a machine without delta.
	#   alt: "less -FRX"   → plain git output (F: quit if one screen, R: colours, X: keep screen)
	#   alt: "bat"         → highlighting without diff-specific features
	pager = delta 2>/dev/null || less -FRX

	# Line endings: store LF in the repo, convert CRLF→LF on commit, never touch checkout.
	# Right setting inside WSL. Windows-only tools should use "true" in *their* git.
	#   alt: true   → checkout CRLF, commit LF (Git for Windows default)
	#   alt: false  → no conversion at all (rely on .gitattributes per repo)
	autocrlf = input

	# Warn about / highlight trailing whitespace and space-before-tab in diffs.
	#   alt: add "tab-in-indent" to forbid tabs, "cr-at-eol" to ignore CRs
	whitespace = trailing-space,space-before-tab

	# Cache untracked-file lookups → faster `git status` in large repos.
	#   alt: false (default) if you hit odd caching issues on network filesystems
	untrackedCache = true

	# Built-in file system monitor makes status near-instant in huge repos.
	# Off by default because it is unreliable on /mnt/c (Windows drives) in WSL.
	#   alt: true → enable for big repos on the Linux filesystem (~/…)
	# fsmonitor = true

	# Global ignore file. This path is git's default anyway; stated for clarity.
	excludesFile = ~/.config/git/ignore

[init]
	# Branch name for `git init`.
	#   alt: master / trunk / develop
	defaultBranch = main

[user]
	# Refuse to commit until name/e-mail are set for this repo or globally —
	# prevents commits as "user@hostname" on a fresh machine.
	#   alt: false → git guesses from the hostname
	useConfigOnly = true
	# name / email → ~/.gitconfig.local (written by install.sh)

[commit]
	# Show the diff below the commit message template in the editor.
	#   alt: false → just the file list
	verbose = true

	# Sign every commit (needs gpg.format + user.signingKey in ~/.gitconfig.local).
	#   alt: true → see the [gpg] section below for SSH signing
	# gpgSign = true

[gpg]
	# Sign with your existing SSH key instead of a GPG key (GitHub/GitLab verify it).
	#   alt: openpgp (default) → classic GPG, needs gpg-agent
	#   alt: x509              → S/MIME certificates (corporate)
	# format = ssh

[pull]
	# `git pull` = fetch + rebase your local commits on top → linear history, no merge bubbles.
	#   alt: false          → fetch + merge (creates "Merge branch 'main' of …" commits)
	#   alt: ff only via [pull] ff = only → refuse unless fast-forward; you decide manually
	rebase = true

[rebase]
	# Stash dirty changes before a rebase and re-apply afterwards.
	#   alt: false → rebase refuses to start with a dirty tree
	autoStash = true

	# `git commit --fixup <sha>` commits are moved/squashed automatically by `rebase -i`.
	#   alt: false → you reorder fixups by hand
	autoSquash = true

	# When rebasing a stack of branches, move the branch pointers in between too.
	#   alt: false → only the current branch moves
	updateRefs = true

[push]
	# `git push` without arguments pushes the current branch to a branch of the same name.
	#   alt: simple  (default) → same, but refuses if the upstream name differs
	#   alt: upstream          → push to whatever upstream is configured
	#   alt: nothing           → always require an explicit refspec
	default = current

	# First push of a new branch sets the upstream automatically (no --set-upstream / -u).
	#   alt: false → git asks you to run `git push -u origin <branch>`
	autoSetupRemote = true

	# Push annotated tags that point at the pushed commits.
	#   alt: false → push tags explicitly with `git push --tags`
	followTags = true

[fetch]
	# Delete local remote-tracking branches that are gone on the remote.
	#   alt: false → stale origin/* branches pile up (gcmb / gsmb rely on this too)
	prune = true

	# Same for tags deleted on the remote.
	#   alt: false → keep old tags locally
	pruneTags = true

	# `git fetch` fetches all remotes, not only origin.
	#   alt: false → only the default remote
	all = true

[merge]
	# Conflict markers also show the common ancestor, with identical lines trimmed.
	#   alt: merge (default) → only "ours" and "theirs"
	#   alt: diff3           → ancestor too, without trimming
	conflictStyle = zdiff3

	# Tool for `git mergetool`.
	#   alt: vscode (with mergetool.vscode.cmd), meld, kdiff3
	tool = nvimdiff

[mergetool]
	# Don't leave *.orig backup files after resolving.
	keepBackup = false
	prompt = false

[diff]
	# Better diff algorithm for moved/re-indented code than the default "myers".
	#   alt: patience → similar, slightly different heuristics
	#   alt: myers    → default, fastest
	algorithm = histogram

	# Show moved lines in a different colour than added/removed lines.
	#   alt: zebra / dimmed-zebra / plain / no
	colorMoved = default
	colorMovedWS = allow-indentation-change

	# Prefix paths with i/ w/ c/ (index, worktree, commit) instead of a/ b/ —
	# tells you at a glance what is compared.
	#   alt: false → a/ and b/
	mnemonicPrefix = true

	# Detect renames AND copies.
	#   alt: true → renames only (default), false → off (faster on huge diffs)
	renames = copies

	# Submodule changes as a short log, not just a hash change.
	#   alt: short (default), diff → full diff of the submodule
	submodule = log

	tool = nvimdiff

[interactive]
	# Colourise `git add -p` hunks with delta (falls back to plain if delta is missing).
	diffFilter = delta --color-only 2>/dev/null || cat

[delta]
	# https://dandavison.github.io/delta/
	navigate = true          # n / N jump between files in the pager
	line-numbers = true
	side-by-side = false     # alt: true → GitHub-style split view (needs a wide terminal)
	hyperlinks = false       # alt: true → clickable file paths in Windows Terminal
	# no syntax-theme set → delta follows $BAT_THEME (tokyonight_night, like bat)
	#   alt: syntax-theme = OneHalfDark   (see `delta --list-syntax-themes`)

[status]
	# Show the stash count in `git status`.
	showStash = true
	# Show individual files in untracked directories.
	#   alt: normal (default) → just the directory
	#   alt: no               → hide untracked files (big speed-up in huge repos)
	showUntrackedFiles = all
	# Summarise submodule changes.
	submoduleSummary = true

[branch]
	# `git branch` lists the most recently committed branch first.
	#   alt: refname (default, alphabetical), -authordate
	sort = -committerdate

[tag]
	# Sort tags as versions (v1.10 after v1.9).
	#   alt: refname (default, alphabetical) → v1.10 before v1.2
	sort = version:refname

[column]
	# Lay out `git branch` / `git tag` / `git status` lists in columns when they fit.
	#   alt: never (default)
	ui = auto

[log]
	# Short ISO dates in `git log` (2026-11-16 04:30:00 +0100).
	#   alt: relative ("3 days ago"), short, iso-strict, local
	date = iso

	# Follow renames when logging a single file.
	follow = true

[rerere]
	# "Reuse recorded resolution": remember how you fixed a conflict and replay it
	# the next time the same conflict appears (great with frequent rebases).
	#   alt: false → resolve every time
	enabled = true
	autoUpdate = true

[help]
	# Mistyped command (`git stauts`) → ask "did you mean status? [y/N]".
	#   alt: 10 → run it after 1.0 s, immediate → run at once, 0 → just show suggestion
	autocorrect = prompt

[submodule]
	# `git pull` / `checkout` also update submodules.
	#   alt: false (default) → run `git submodule update` yourself
	recurse = true

[credential]
	# The credential helper is chosen per machine in ~/.gitconfig.local:
	#   WSL + Git for Windows installed → Windows Git Credential Manager
	#     (shares logins with Windows, supports GitHub/Azure DevOps OAuth + 2FA)
	#   alt: helper = cache --timeout=3600 → keep in memory for an hour
	#   alt: helper = store                → plaintext ~/.git-credentials (avoid)
	#   alt: `gh auth setup-git`           → GitHub CLI as helper

[url "git@github.com:"]
	# Uncomment to always use SSH for GitHub, even when a repo was cloned via https.
	#   alt: remove the section → keep whatever URL was used
	# insteadOf = https://github.com/

# --- WSL: repositories on Windows drives -------------------------------------------
# Files on /mnt/c have no real Unix permissions → git would show every file as
# "mode changed". Turn that off only there.
[includeIf "gitdir:/mnt/"]
	path = ~/.config/git/wsl-mnt

# --- aliases ---------------------------------------------------------------------
# (shell aliases like gst/gco come from oh-my-zsh / omz-compat.sh — these work in any shell
#  and inside other tools as `git <alias>`)
[alias]
	st = status --short --branch
	co = checkout
	sw = switch
	br = branch -vv
	ci = commit
	amend = commit --amend --no-edit
	# undo the last commit, keep its changes staged
	undo = reset --soft HEAD~1
	# throw away everything not committed (asks nothing — careful)
	nuke = !git reset --hard && git clean -fd
	# graph of all branches
	lg = log --graph --abbrev-commit --decorate --format='%C(yellow)%h%C(reset) %C(blue)%ad%C(reset) %C(green)%an%C(reset)%C(auto)%d%C(reset) %s' --date=short --all
	last = log -1 HEAD --stat
	# files changed in the last commit
	changed = show --pretty= --name-status
	# quick work-in-progress commit / unwind it
	wip = !git add -A && git commit --no-verify -m 'WIP'
	unwip = !git log -1 --format=%s | grep -q '^WIP$' && git reset HEAD~1
	# branches whose upstream is gone (same as the gsmb shell function)
	gone = !git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" {print $1}'
	# who touched this file most
	who = shortlog -sne --
	aliases = !git config --get-regexp '^alias\\.' | sed 's/^alias\\.//'

# --- multiple identities (work / private / customers) ------------------------------------
# Rules live in ~/.gitconfig.local (machine-specific, not in the repo); create them with
#   git-identity add <name> --dir ~/work/ --url gitlab.company.com --email you@company.com
# Git picks an identity file by WHERE the repo is or WHERE its remote points:
#   [includeIf "gitdir:~/work/"]                                    path = ~/.config/git/identities/work
#   [includeIf "hasconfig:remote.*.url:https://gitlab.company.com/**"] path = ~/.config/git/identities/work
#   [includeIf "hasconfig:remote.*.url:git@gitlab.company.com:*/**"]  path = ~/.config/git/identities/work
#     alt: "gitdir/i:" → case-insensitive (repos on /mnt/c)
#     alt: "onbranch:release/**" → settings only on certain branches
# Credentials are chosen by the URL being accessed (works even for `git clone`):
#   [credential "https://gitlab.company.com"]  helper =  /  helper = rbw  /  username = jdoe
# Check what applies in a repo:  git-identity check   (= git config --show-origin user.email …)

# --- personal / machine-specific (keep last so it wins) -------------------------------
[include]
	path = ~/.gitconfig.local
