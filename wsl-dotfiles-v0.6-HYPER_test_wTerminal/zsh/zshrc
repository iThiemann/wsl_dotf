# ==============================================================================
# ~/.zshrc — managed by wsl-dotfiles (edit the repo, not the symlink target)
#   Machine-specific stuff goes into ~/.zshrc.local
#   Same layout as the macOS setup:
#     10-env  30-source (oh-my-zsh + tools)  40-functions  50-aliases  60-bindkeys
# ==============================================================================

[[ -o interactive ]] || return

for _rc in ~/.zshrc.d/*.zsh(N); do
  source "$_rc"
done
unset _rc

[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local

# zsh-syntax-highlighting must be sourced LAST, after every widget exists
# (on the Mac it was loaded both as a plugin and from Homebrew — once is enough)
_zsh_hl="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
[[ -r $_zsh_hl ]] && source "$_zsh_hl"
unset _zsh_hl
