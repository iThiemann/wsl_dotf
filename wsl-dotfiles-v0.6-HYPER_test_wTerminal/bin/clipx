#!/usr/bin/env bash
# ==============================================================================
# clipx — text transforms for DevOps work (used by the AutoHotkey script, also handy in shells)
#
#   clipx <op> [in-file out-file]     files may be Windows paths (C:\...)
#   pbpaste | clipx jwt               stdin → stdout
#
#   ops: json  json-compact  yaml2json  json2yaml  b64d  b64e  jwt  urld  urle
#        epoch (epoch ↔ ISO date)  sort  uniq  lower  upper  trim  lines (count)
# ==============================================================================
set -uo pipefail
op="${1:-}"; shift || true
if [[ $# -ge 2 ]]; then
  in="$1"; out="$2"
  [[ $in == *:\\* ]] && in="$(wslpath -u "$in")"
  [[ $out == *:\\* ]] && out="$(wslpath -u "$out")"
  exec <"$in" >"$out"
fi

py() { python3 -c "$1"; }

case "$op" in
  json)         jq . ;;
  json-compact) jq -c . ;;
  yaml2json)    py 'import sys,json,yaml; print(json.dumps(yaml.safe_load(sys.stdin), indent=2, default=str))' ;;
  json2yaml)    py 'import sys,json,yaml; print(yaml.safe_dump(json.load(sys.stdin), sort_keys=False), end="")' ;;
  b64d)         tr -d ' \r\n' | base64 -d ;;
  b64e)         base64 -w0; echo ;;
  jwt)          py '
import sys, json, base64
parts = sys.stdin.read().strip().split(".")
def dec(p):
    p += "=" * (-len(p) % 4)
    return json.loads(base64.urlsafe_b64decode(p))
out = {"header": dec(parts[0]), "payload": dec(parts[1])}
import datetime
for k in ("exp", "iat", "nbf"):
    v = out["payload"].get(k)
    if isinstance(v, (int, float)):
        out["payload"][k + "_utc"] = datetime.datetime.fromtimestamp(v, datetime.timezone.utc).isoformat()
print(json.dumps(out, indent=2))' ;;
  urld)         py 'import sys,urllib.parse; print(urllib.parse.unquote(sys.stdin.read().strip()))' ;;
  urle)         py 'import sys,urllib.parse; print(urllib.parse.quote(sys.stdin.read().strip(), safe=""))' ;;
  epoch)        read -r v; v="${v//[[:space:]]/}"
                if [[ $v =~ ^[0-9]{13}$ ]]; then date -u -d "@$((v / 1000))" +%Y-%m-%dT%H:%M:%SZ
                elif [[ $v =~ ^[0-9]+$ ]]; then date -u -d "@$v" +%Y-%m-%dT%H:%M:%SZ
                else date -u -d "$v" +%s; fi ;;
  sort)         sort ;;
  uniq)         sort -u ;;
  lower)        tr '[:upper:]' '[:lower:]' ;;
  upper)        tr '[:lower:]' '[:upper:]' ;;
  trim)         sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' ;;
  lines)        wc -l ;;
  *)            sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
