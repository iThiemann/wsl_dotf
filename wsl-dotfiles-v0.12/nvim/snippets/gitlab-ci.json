{
  "job": {
    "prefix": "gljob",
    "description": "GitLab CI job",
    "body": [
      "${1:job}:",
      "  stage: ${2:test}",
      "  image: ${3:alpine:3.20}",
      "  script:",
      "    - ${4:echo hello}",
      "  rules:",
      "    - if: \\$CI_PIPELINE_SOURCE == \"merge_request_event\"",
      "    - if: \\$CI_COMMIT_BRANCH == \\$CI_DEFAULT_BRANCH",
      "$0"
    ]
  }
}